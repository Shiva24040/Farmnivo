# PostgreSQL connection used by Prisma in development and production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rythu_sarvam

# Long random server-only secret, minimum 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# OpenAI-compatible server-side AI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini
AI_BASE_URL=https://api.openai.com/v1

# Optional object storage provider for production media uploads.
# Configure a signed-upload service or your own server-side storage adapter before enabling media uploads.
STORAGE_BASE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Set false to disable OpenAI hosted web search for current-information questions.
OPENAI_WEB_SEARCH=auto

# Real IoT gateway ingestion (optional)
IOT_INGEST_TOKEN=replace-with-a-long-random-device-token
IOT_DEFAULT_USER_ID=postgres-user-id
